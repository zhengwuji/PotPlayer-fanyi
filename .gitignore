# 忽略虚拟环境
.venv/

# 忽略 PyInstaller 生成的文件
build/
dist/

# 注意：installer.spec 必须纳入版本控制，
# 否则 Releases 里的 installer.exe 无法从源码复现。
# 原版此处是 *.spec，已移除。
!installer.spec

# 忽略 Python 缓存文件
__pycache__/
*.pyc
*.pyo
*.pyd

# 忽略 IDE 配置文件
.vscode/
.idea/

# 忽略日志文件
*.log

# 忽略临时文件
*.tmp
*.temp

# 忽略 macOS 系统文件
.DS_Store

# 忽略 Windows 系统文件
Thumbs.db